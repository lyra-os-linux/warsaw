# The upstream RPM installs its private payload under /usr/local; changing the
# paths would modify the vendor layout. The binaries are redistributed
# unmodified and may keep their upstream sections, modes and private naming.
addFilter("E: file-in-usr-local /usr/local/")
addFilter("E: dir-or-file-in-usr-local /usr/local/")
addFilter("E: dir-in-usr-local /usr/local/")
addFilter("E: script-without-shebang /usr/local/etc/warsaw/")
addFilter("E: executable-marked-as-config-file /usr/local/etc/warsaw/")
addFilter("W: unstripped-binary-or-object /usr/local/")
addFilter("E: missing-hash-section /usr/local/")
addFilter("E: library-without-ldconfig-postin /usr/local/lib/warsaw/")
addFilter("E: library-without-ldconfig-postun /usr/local/lib/warsaw/")
addFilter("W: library-without-ldconfig-postin /usr/local/lib/warsaw/")
addFilter("W: library-without-ldconfig-postun /usr/local/lib/warsaw/")
addFilter("E: shared-lib-without-version /usr/local/lib/warsaw/")
addFilter("E: shlib-without-versioned-soname /usr/local/lib/warsaw/")
# The license mixes LGPL-3.0-or-later with the vendor's redistribution terms.
addFilter("W: invalid-license")
addFilter("E: invalid-license")
# The changelog lives in warsaw.changes, as in the other Lyra packages.
addFilter("E: no-changelogname-tag")
addFilter("W: no-changelogname-tag")
