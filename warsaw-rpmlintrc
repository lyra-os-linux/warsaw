# The payload is the official Warsaw RPM, redistributed byte for byte (see
# warsaw-files.sha256). The errors below come from the vendor's files and
# layout; fixing them would mean modifying or relocating the binaries, which
# the license does not allow. The risks are documented in README.md.

# The vendor installs its private payload under /usr/local and the binaries
# load it from there by absolute path.
addFilter("filelist-forbidden-fhs23 /usr/local")

# /etc/init.d/warsaw is part of the official payload. systemd uses
# warsaw.service and ignores the init script, which is shadowed by the unit.
addFilter("deprecated-init-script warsaw")
addFilter("systemd-shadowed-initscript warsaw")

# Vendor binaries, built by Topaz. They cannot be rebuilt or patched.
addFilter("executable-stack /usr/local/lib/warsaw/wsbrmu.so")
addFilter("missing-call-to-setgroups-before-setuid /usr/local/bin/warsaw/core")
